# Local development defaults (see README)
DATABASE_URL=file:./data/local.sqlite
SESSION_SECRET=dev-session-secret-change-me-in-production-32chars
ADMIN_PASSWORD=admin-dev-only
TRANSPARENCY_COMMITMENT_SECRET=dev-transparency-secret

# Cloudflare Turnstile (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Development only — NEVER set true in production (app refuses to start)
TURNSTILE_BYPASS_DEV=true

# Email: stub logs to console locally; production must use resend (or another provider)
EMAIL_PROVIDER=stub
RESEND_API_KEY=

APP_URL=http://localhost:3000
